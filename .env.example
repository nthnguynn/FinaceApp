# Sao chép thành .env rồi điền giá trị thật

# ===== Chạy trên máy (bun run dev) =====
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/moniii"
# Tạo bằng: openssl rand -hex 32
JWT_SECRET=""
# Đặt "true" khi chạy sau HTTPS
COOKIE_SECURE="false"
# (Tùy chọn) Domain công khai dùng để hiển thị Webhook URL
NEXT_PUBLIC_APP_URL=""

# ===== Thêm khi chạy bằng docker compose trên server =====
# Host của DB là tên service "postgres", không phải localhost:
#   DATABASE_URL="postgresql://moniii:MAT_KHAU_MANH@postgres:5432/moniii"
POSTGRES_USER="moniii"
POSTGRES_PASSWORD=""
POSTGRES_DB="moniii"
# Cổng trên máy chủ (container luôn chạy 3000 bên trong)
APP_PORT="3005"
